{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "智约：启动前后端联调",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-File",
        "${workspaceFolder}/start-dev.ps1",
        "-Python",
        "${command:python.interpreterPath}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
